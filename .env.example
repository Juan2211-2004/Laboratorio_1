# Copia este archivo como .env y cambia los valores.
# El archivo .env NO se sube a GitHub (está en .gitignore).

# Base de datos
POSTGRES_DB=academichub
POSTGRES_USER=academichub
# Usa solo letras, números, - o _ (caracteres como @ : / # rompen la URL de conexión).
POSTGRES_PASSWORD=cambia_esta_clave_123
DB_PORT=5432

# Seguridad de la API: usa una cadena larga y aleatoria.
# Puedes generar una con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio
JWT_EXPIRES_IN=8h

# Usuario de demostración (se crea solo la primera vez que arranca el backend)
DEMO_EMAIL=estudiante@academichub.com
DEMO_PASSWORD=Academic123
DEMO_NAME=Estudiante

# Puerto donde abrirás la aplicación: http://localhost:8080
APP_PORT=8080
